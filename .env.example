# Copy to .env and fill in real values locally. Never commit .env.
# Get DB connection strings from: Supabase project settings -> Database -> Connection string
# Project: "Orange restaurant Demo" (qpngoxqhjshzgbuxvzkx) -- see CLAUDE.md for context.

# Pooled connection (used by the app at runtime, via pgbouncer)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.qpngoxqhjshzgbuxvzkx.supabase.co:6543/postgres?pgbouncer=true"

# Direct connection (used by Prisma for migrations only)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.qpngoxqhjshzgbuxvzkx.supabase.co:5432/postgres"

# Restricted runtime role for the shared-platform Core tables (workspaces,
# workspace_memberships, products, workspace_products, subscriptions).
# Does NOT bypass RLS -- see src/lib/corePrisma.ts. Never fall back to
# DATABASE_URL if this is unset; the app_runtime password was generated
# server-side during migration and was never exposed -- set a new one via
# `ALTER ROLE app_runtime WITH PASSWORD '...'` run directly against the
# database before filling this in.
APP_RUNTIME_DATABASE_URL="postgresql://app_runtime:[YOUR-APP-RUNTIME-PASSWORD]@db.qpngoxqhjshzgbuxvzkx.supabase.co:6543/postgres?pgbouncer=true"

# Supabase public (client-side safe) config
NEXT_PUBLIC_SUPABASE_URL="https://qpngoxqhjshzgbuxvzkx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_J7UEdoHNiRpNcRNZPw6kFw_E7qHXOlk"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
