# Meta Comment-to-DM Automation Engine — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Database -----------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/meta_dm_engine?schema=public"

# --- App auth (NextAuth/Auth.js) ----------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# --- Meta Developer App ---------------------------------------------------
# See docs/META_SETUP.md for how to obtain these.
META_APP_ID=
META_APP_SECRET=
# Keep this configurable — verify the currently supported Graph API
# version at https://developers.facebook.com/docs/graph-api/changelog
# before deploying. v25.0 below is a best-effort value as of 2026-08-26
# from secondary sources (direct fetch to Meta's docs was blocked in the
# environment that set this) — confirm it yourself before going live.
META_GRAPH_API_VERSION=v25.0
META_REDIRECT_URI="http://localhost:3000/api/auth/meta/callback"

# Shared secret you choose; must match the "Verify Token" configured in
# the Meta App Dashboard's webhook subscription.
WEBHOOK_VERIFY_TOKEN=

# --- Token encryption -----------------------------------------------------
# 32-byte key for AES-256-GCM, base64 or hex encoded.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- MCP server -----------------------------------------------------------
MCP_SERVER_PORT=3001
# Shared bearer token for initial single-tenant MCP access.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# The user account MCP_AUTH_TOKEN operates on (their app login email).
MCP_AUTH_USER_EMAIL=

# --- Local development -----------------------------------------------------
# When true, Meta API calls are simulated (no real network calls, no
# App Review required). See docs/META_SETUP.md and scripts/test-meta-webhook.ts.
MOCK_META=false
