// Meta Comment-to-DM Automation Engine — database schema
// Schema-first workflow: this file is the source of truth for the data
// model. Run `npm run prisma:migrate` after any change here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  AGENCY
}

enum Platform {
  INSTAGRAM
  FACEBOOK
}

enum MatchType {
  CONTAINS
  EXACT
  REGEX
}

enum TriggerStatus {
  SUCCESS
  FAILED
  SKIPPED
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) models
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Core application models
// ---------------------------------------------------------------------------

model User {
  id               String           @id @default(cuid())
  name             String?
  email            String?          @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  subscriptionTier SubscriptionTier @default(FREE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  accounts       Account[]
  sessions       Session[]
  socialAccounts SocialAccount[]
  automations    Automation[]
  mcpApiKeys     McpApiKey[]

  @@map("users")
}

model SocialAccount {
  id                String    @id @default(cuid())
  userId            String
  platform          Platform
  accountId         String
  accessToken       String    @db.Text
  refreshToken      String?   @db.Text
  username          String?
  pageId            String?
  instagramUserId   String?
  tokenExpiresAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  automations  Automation[]
  triggerLogs  TriggerLog[]

  @@unique([platform, accountId])
  @@index([userId])
  @@index([pageId])
  @@index([instagramUserId])
  @@map("social_accounts")
}

model Automation {
  id              String    @id @default(cuid())
  userId          String
  socialAccountId String
  keyword         String
  matchType       MatchType @default(CONTAINS)
  replyMessage    String    @db.Text
  linkUrl         String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  triggerLogs   TriggerLog[]

  @@index([userId])
  @@index([socialAccountId, isActive])
  @@map("automations")
}

model TriggerLog {
  id                 String        @id @default(cuid())
  automationId       String
  socialAccountId    String
  commenterId         String
  commenterUsername   String?
  commentId          String
  postId             String?
  postUrl            String?
  commentText        String        @db.Text
  status             TriggerStatus
  errorMessage       String?       @db.Text
  dmSentAt           DateTime?
  createdAt          DateTime      @default(now())

  automation    Automation    @relation(fields: [automationId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, commentId])
  @@index([automationId])
  @@index([status])
  @@map("trigger_logs")
}

model WebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  payload     Json
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([processed])
  @@map("webhook_events")
}

// API keys for MCP / programmatic access, scoped to a single user.
// MCP_AUTH_TOKEN (env) is used for initial single-tenant deployment;
// this table is the structure for per-user keys once that's needed.
model McpApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mcp_api_keys")
}
