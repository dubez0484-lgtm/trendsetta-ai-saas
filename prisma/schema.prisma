// Prisma schema for the THETRENDSETTA shared core platform.
// This maps onto the existing "Orange restaurant Demo" Supabase Postgres
// project (qpngoxqhjshzgbuxvzkx) exactly as introspected -- table and
// column names use @@map/@map so the underlying schema is untouched.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  AGENCY
}

enum Platform {
  INSTAGRAM
  FACEBOOK
}

enum MatchType {
  CONTAINS
  EXACT
  REGEX
}

enum TriggerStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String?           @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  subscriptionTier SubscriptionTier  @default(FREE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  accounts       Account[]
  sessions       Session[]
  socialAccounts SocialAccount[]
  automations    Automation[]
  mcpApiKeys     McpApiKey[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model SocialAccount {
  id               String    @id @default(cuid())
  userId           String
  platform         Platform
  accountId        String
  accessToken      String
  refreshToken     String?
  username         String?
  pageId           String?
  instagramUserId  String?
  tokenExpiresAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  automations Automation[]
  triggerLogs TriggerLog[]

  @@map("social_accounts")
}

model Automation {
  id              String    @id @default(cuid())
  userId          String
  socialAccountId String
  keyword         String
  matchType       MatchType @default(CONTAINS)
  replyMessage    String
  linkUrl         String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  triggerLogs   TriggerLog[]

  @@map("automations")
}

model TriggerLog {
  id                String        @id @default(cuid())
  automationId      String
  socialAccountId   String
  commenterId       String
  commenterUsername String?
  commentId         String
  postId            String?
  postUrl           String?
  commentText       String
  status            TriggerStatus
  errorMessage      String?
  dmSentAt          DateTime?
  createdAt         DateTime      @default(now())

  automation    Automation    @relation(fields: [automationId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("trigger_logs")
}

model WebhookEvent {
  id        String   @id @default(cuid())
  eventId   String
  eventType String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("webhook_events")
}

model McpApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mcp_api_keys")
}
